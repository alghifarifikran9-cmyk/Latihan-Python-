class Solution:

  def romanToInt(self, s: str) -> int:
    buku = {
        'I': 1,
        'V': 5,
        'X': 10,
        'L': 50,
        'C': 100,
        'D': 500,
        'M': 1000,
    }

    total = 0

    for i, char in enumerate(s):
      if i < len(s) - 1 and buku[char] < buku[s[i + 1]]:
        total -= buku[char]  # Pakai -= (satu minus, satu sama dengan)
      else:
        total += buku[char]  # Diberi indentasi sejajar dengan baris atas

    return total
